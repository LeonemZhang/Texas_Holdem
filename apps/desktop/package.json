{
  "name": "@texas-holdem/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm build && wait-on tcp:5173 && cross-env CLIENT_DEV_URL=http://localhost:5173 electron .",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "cross-env": "10.0.0",
    "electron": "43.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "dependencies": {
    "@texas-holdem/lan-discovery": "workspace:*",
    "zod": "4.3.6"
  }
}
