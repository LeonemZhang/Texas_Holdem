{
  "name": "@texas-holdem/mcp-server",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest:closed-loop": "pnpm --filter @texas-holdem/host... build && pnpm build",
    "test:closed-loop": "vitest run --config vitest.closed-loop.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@texas-holdem/protocol": "workspace:*",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
